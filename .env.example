# Variables de entorno del proyecto. Este archivo NO contiene valores reales.
# Los valores se configuran como SECRETOS en el proveedor de despliegue (nunca en el repo ni en el chat).
# Las NEXT_PUBLIC_* se incrustan en el cliente: son PÚBLICAS. Nada sensible ahí.

# --- públicas ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | preview | staging | production (solo production es indexable)
NEXT_PUBLIC_SITE_ENV=development

# --- servidor ---
# Destino de los leads: log (por defecto, sin PII) | resend (módulo email-resend)
LEAD_SINK=log

# --- Hotel Aurora (reservadas para la fase de implementación; hoy no se leen) ---
# 1 = proyecto de portafolio: pagos imposibles y notificaciones solo en vista previa (ADR-0003).
# Si DEMO_MODE=1 y existe cualquier variable de pasarela de pago, la aplicación NO arranca.
DEMO_MODE=1
# Base de datos y autenticación (ADR-0004). La URL y la clave ANON son públicas por diseño;
# la SERVICE_ROLE es SECRETA y solo se usa en el servidor.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Correo transaccional (propuesto). En DEMO_MODE no se envía nada real.
# RESEND_API_KEY=
# WhatsApp Business (propuesto). En DEMO_MODE no se envía nada real.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Verificación anti-bots en registro y acceso (propuesto).
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=
