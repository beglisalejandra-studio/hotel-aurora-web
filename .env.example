# Variables de entorno del proyecto. Este archivo NO contiene valores reales.
# Los valores se configuran como SECRETOS en el proveedor de despliegue (nunca en el repo ni en el chat).
# Las NEXT_PUBLIC_* se incrustan en el cliente: son PÚBLICAS. Nada sensible ahí.

# --- públicas ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | preview | staging | production (solo production es indexable)
NEXT_PUBLIC_SITE_ENV=development

# Panel de contenido (Sanity). El ID del proyecto y el dataset son públicos.
NEXT_PUBLIC_SANITY_PROJECT_ID=7keq933j
NEXT_PUBLIC_SANITY_DATASET=production

# --- servidor ---
# Sanity: token de SOLO LECTURA (permiso «Viewer») para el editor visual del panel («Editar la web»): lee los borradores
# en la vista previa. Solo servidor; nunca NEXT_PUBLIC_. Sin él, el panel funciona pero «Editar la web» explica que falta.
SANITY_API_READ_TOKEN=
# Secreto del webhook de revalidación (opcional)
SANITY_REVALIDATE_SECRET=
# Destino de las solicitudes de mesa, spa y bono: log (por defecto: solo registra que llegó una, sin datos personales)
# | resend (las envía por correo al hotel; necesita las tres variables siguientes)
LEAD_SINK=log
# Secreto. Empieza por re_. Solo en el gestor del proveedor.
RESEND_API_KEY=
# Buzón del hotel que recibe las solicitudes
LEAD_NOTIFY_TO=
# Remitente de un dominio VERIFICADO en Resend, p. ej. Web <web@dominio-del-hotel.com>
LEAD_NOTIFY_FROM=
# Clave de la API de Anthropic (opcional; solo servidor): sugiere la descripción de las fotos en el panel y activa las
# preguntas libres del asistente de la web. Sin ella, el asistente responde con las preguntas frecuentes del panel.
ANTHROPIC_API_KEY=
