{
  "name": "hotel-aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web de Hotel Aurora (proyecto web-os)",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse-check.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "e2e:cross": "CROSS_BROWSER=1 playwright test",
    "audit": "node scripts/audit-gate.mjs",
    "doctor": "node scripts/doctor.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "refs": "node scripts/capture-references.mjs",
    "media:score": "node scripts/video-score-cli.mjs",
    "media:optimize": "node scripts/media-optimize.mjs",
    "media:probe": "node scripts/media-probe.mjs",
    "media:request": "node scripts/media-request.mjs",
    "media:intake": "node scripts/media-intake.mjs",
    "media:generate": "node scripts/gemini-media.mjs",
    "tokens": "node scripts/tokens-to-css.mjs design/tokens.figma.json --out app/tokens.css --format theme",
    "module:add": "node scripts/apply-module.mjs",
    "report": "node scripts/client-report.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
